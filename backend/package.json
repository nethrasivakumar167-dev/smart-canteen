{
  "name": "smart-canteen-backend",
  "version": "1.0.0",
  "description": "Smart Canteen Preorder & Management Platform Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "create-admin": "ts-node scripts/createAdmin.ts",
    "walkthrough": "ts-node scripts/walkthrough.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run --fileParallelism=false"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [
    "smart-canteen",
    "express",
    "prisma",
    "typescript"
  ],
  "author": "Smart Canteen Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.4"
  }
}