// Prisma schema for Smart Canteen Preorder & Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY_TO_PICK
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  ONLINE_MOCK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  institutionId String?  @unique
  phone         String?
  passwordHash  String
  role          Role     @default(STUDENT)
  isActive      Boolean  @default(true)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]    @relation("StudentOrders")
  deliveredOrders Order[]    @relation("StaffDeliveredOrders")
  feedback        Feedback[]
  favorites       Favorite[]

  @@index([email])
  @@index([role])
  @@index([institutionId])
}

model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  isAvailable  Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuItems MenuItem[]
}

model MenuItem {
  id           String   @id @default(uuid())
  categoryId   String
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  isVegetarian Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  favorites  Favorite[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isAvailable])
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  studentId     String
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(RECEIVED)
  deliveredAt   DateTime?
  deliveredById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student     User        @relation("StudentOrders", fields: [studentId], references: [id], onDelete: Restrict)
  deliveredBy User?       @relation("StaffDeliveredOrders", fields: [deliveredById], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    Payment[]
  feedback    Feedback?

  @@index([studentId])
  @@index([orderStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  menuItemId      String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([orderId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Feedback {
  id        String   @id @default(uuid())
  studentId String
  orderId   String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([studentId])
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
}
