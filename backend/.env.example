# Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/smart_canteen?schema=public"

# JWT Authentication
JWT_SECRET="REPLACE_ME_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="7d"

# QR Code Token Secret
QR_SECRET="REPLACE_ME_generate_with_openssl_rand_hex_32"

# AI Integration (Optional / Mockable adapter)
GEMINI_API_KEY=""
AI_PROVIDER="mock" # options: mock, gemini

# Demo password for seeded users (change in production!)
DEMO_PASSWORD="password123"