# Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5433/smart_canteen?schema=public"

# JWT Authentication
JWT_SECRET="REPLACE_ME_generate_with_openssl_rand_hex_32"
JWT_EXPIRES_IN="7d"

# AI Integration (Optional / Mockable adapter)
GEMINI_API_KEY="replace_with_your_gemini_api_key"
AI_PROVIDER="gemini" # options: mock, gemini
# Select a model returned by ListModels with generateContent support.
GEMINI_MODEL=""
# Demo password for seeded users (change in production!)
DEMO_PASSWORD="password123"

# Enforce menu meal-time windows (defaults to false in NODE_ENV=test)
MENU_TIME_WINDOWS=true

# Strict pickup-slot validation; set false to test past slots outside lead-time rules
PICKUP_SLOT_STRICT=true