# Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_canteen?schema=public"

# JWT Authentication
JWT_SECRET="smart-canteen-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# QR Code Token Secret
QR_SECRET="smart-canteen-qr-secret-token-key-2026"

# AI Integration (Optional / Mockable adapter)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="mock" # options: mock, gemini, openai

# Payment Gateway (Razorpay - placeholder for Phase 3/7)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
