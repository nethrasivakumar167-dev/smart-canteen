# Root Environment Configuration for Docker Compose
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# PostgreSQL
POSTGRES_PASSWORD=REPLACE_ME_secure_postgres_password

# Backend Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32

# Public frontend origin allowed by the backend
CLIENT_URL=http://localhost:5173

# Public backend API origin embedded into the frontend bundle
VITE_API_URL=http://localhost:5000/api